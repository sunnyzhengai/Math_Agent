{
  "id": "quad.discriminant",
  "name": "Use the discriminant to count real solutions",
  "domain": "Quadratics",
  "grade_band": "9-10",
  "description": "Given ax^2 + bx + c = 0, use D=b^2-4ac to determine the number of real solutions.",
  "prereqs": ["quad.identify"],
  "successors": ["quad.formula"],

  "learning_objectives": [
    {"id": "LO1", "text": "Compute D = b^2 - 4ac correctly"},
    {"id": "LO2", "text": "Interpret D>0, D=0, D<0 as two/one/zero real roots"},
    {"id": "LO3", "text": "Connect discriminant to graph intercepts"}
  ],

  "knowledge_requirements": [
    {"id": "KR1", "text": "Substitute a,b,c carefully (signs!)"},
    {"id": "KR2", "text": "Square and multiply accurately"}
  ],

  "common_misconceptions": [
    {
      "id": "under_root_error",
      "pattern_hint": "Wrong D due to sign mistake or bad arithmetic",
      "explain": "Compute b^2 and 4ac separately; subtract with correct signs.",
      "remedy_skill": "quad.discriminant"
    }
  ],

  "item_templates": [
    {
      "id": "T1",
      "type": "mcq",
      "stem_template": "For {a}x^2 + {b}x + {c} = 0, how many real solutions are there?",
      "generator_params": {
        "ranges": {"a": [1,2,3,4], "b": [-8,-6,-4,-2,0,2,4,6,8], "c": [-6,-4,-2,0,2,4,6]},
        "constraints": []
      },
      "answer_key": "Compute D=b^2-4ac; D>0→two, D=0→one, D<0→none.",
      "diagnostic_choices": [
        {"text_template": "{truth}", "tags_on_select": ["correct"]},
        {"text_template": "one real solution", "tags_on_select": ["under_root_error"]},
        {"text_template": "two real solutions", "tags_on_select": ["under_root_error"]},
        {"text_template": "no real solutions", "tags_on_select": ["under_root_error"]}
      ],
      "rubric": {
        "full_credit": "Chosen count matches D",
        "partial_credit": []
      }
    }
  ],

  "assessment_blueprint": {
    "recommended_mix": [
      {"template_id": "T1", "count": 3, "difficulty": "med"}
    ],
    "mastery_rule": {
      "min_items": 6,
      "min_accuracy": 0.9,
      "no_repeated_tag_threshold": 2,
      "streak_for_mastery": 3
    }
  },

  "remediation": [
    {
      "trigger_tag": "under_root_error",
      "mini_lesson": "Recompute D carefully: square b first, compute 4ac, then subtract. Double-check signs.",
      "drill_templates": [{"template_id": "T1", "count": 3, "difficulty": "easy"}]
    }
  ],

  "resources": [],
  "difficulty": "med",
  "tags": ["algebra", "quadratics", "discriminant"],
  "telemetry_keys": ["choice_id", "time_taken_ms", "confidence_1to5", "tags_on_select"]
}
